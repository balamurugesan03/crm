PORT=5050
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/crm_saas
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_URL=http://localhost:5730

# Stripe (test mode) - Billing module is disabled until these are set.
# Get keys from https://dashboard.stripe.com/test/apikeys
# Create 3 recurring Prices (Starter/Pro/Enterprise) at https://dashboard.stripe.com/test/products
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# AI assistant (Claude). AI features are disabled until this is set.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
AI_MODEL=

# Customer portal links are signed with this (defaults to a value derived from JWT_ACCESS_SECRET)
PORTAL_SECRET=
