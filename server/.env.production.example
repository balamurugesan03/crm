# ---- Production settings for https://unizova.com/crm ----
# Copy to /var/www/nexuscrm/server/.env on the server and fill in. Never commit the real file.
NODE_ENV=production
PORT=5050
# Public URL including the /crm sub-path (used for CORS, cookies, portal links, Stripe redirects)
CLIENT_URL=https://unizova.com/crm
# Nginx sits in front of Node
TRUST_PROXY=1

# MongoDB — local with auth, or MongoDB Atlas (mongodb+srv://...)
MONGO_URI=mongodb://nexuscrm:CHANGE_ME_DB_PASSWORD@127.0.0.1:27017/nexuscrm?authSource=nexuscrm

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PORTAL_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Where uploaded attachments are stored (keep outside the code folder so deploys don't touch it)
UPLOAD_DIR=/var/lib/nexuscrm/uploads

# Optional: AI features (Claude)
ANTHROPIC_API_KEY=
AI_MODEL=

# Optional: Stripe billing (live keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
